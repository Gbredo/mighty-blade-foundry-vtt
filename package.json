{
  "name": "mighty-blade",
  "version": "2.0.0",
  "description": "CSS compiler for the mighty-blade system",
  "scripts": {
    "build": "sass src/scss/mighty-blade.scss css/mighty-blade.css --style=expanded --no-source-map",
    "build:watch": "sass src/scss/mighty-blade.scss css/mighty-blade.css --watch",
    "build:packs": "node scripts/import_all.mjs",
    "build:equipamentos": "node scripts/import_equipamentos.mjs",
    "build:racas": "node scripts/import_racas.mjs",
    "build:classes": "node scripts/import_classes.mjs",
    "build:habilidades": "node scripts/import_habilidades_e_magias.mjs"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Asacolips",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.3",
    "glob": "^10.3.10",
    "inquirer": "^9.2.15",
    "prompt": "^1.3.0",
    "renamer": "^5.0.0",
    "replace": "^1.2.2",
    "sass": "^1.53.0"
  }
}
