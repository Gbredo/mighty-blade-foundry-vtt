<form class="{{cssClass}} item-sheet-dnd" autocomplete="off">

  {{!-- Header Estilo D&D 5e --}}
  <header class="sheet-header-item">
    <img class="item-profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="item-header-meta">
      <h1 class="item-charname">
        <input name="name" type="text" value="{{item.name}}" placeholder="Nome da Raça" />
      </h1>
      <span class="item-type-pill">RAÇA • ESPÉCIE DE DRAKON</span>
    </div>
  </header>

  {{!-- Barra de Abas do Item --}}
  <nav class="sheet-tabs tabs item-tabs" data-group="primary">
    <a class="item active" data-tab="description">DESCRIÇÃO</a>
    <a class="item" data-tab="details">DETALHES</a>
    <a class="item" data-tab="advancement">AVANÇO</a>
  </nav>

  {{!-- Corpo da Ficha em Abas --}}
  <section class="sheet-body item-body">

    {{!-- 1. ABA DESCRIÇÃO --}}
    <div class="tab description active" data-group="primary" data-tab="description">
      <div class="item-meta-strip">
        <div class="meta-field">
          <span class="meta-label">TIPO DE CRIATURA</span>
          <span class="meta-value">Humanóide</span>
        </div>
        <div class="meta-field">
          <span class="meta-label">CLASSES COMUNS</span>
          <span class="meta-value">{{#if system.classesComuns}}{{system.classesComuns}}{{else}}Todas{{/if}}</span>
        </div>
        <div class="meta-field">
          <span class="meta-label">HABILIDADE RACIAL</span>
          <span class="meta-value">{{#if linkedAbility}}{{linkedAbility.name}}{{else}}—{{/if}}</span>
        </div>
      </div>

      <div class="item-editor-wrap">
        {{editor enrichedDescription target="system.description" rollData=rollData button=true owner=owner editable=editable}}
      </div>
    </div>

    {{!-- 2. ABA DETALHES --}}
    <div class="tab details" data-group="primary" data-tab="details">
      <div class="item-form-group">
        <label><i class="fas fa-shield-halved"></i> Classes Comuns:</label>
        <input type="text" name="system.classesComuns" value="{{system.classesComuns}}" placeholder="Ex: Guerreiro, Paladino, Sacerdote..." />
      </div>
      <div class="item-form-group">
        <label><i class="fas fa-link"></i> UUID da Habilidade Automática:</label>
        <input type="text" name="system.habilidadeUuid" value="{{system.habilidadeUuid}}" placeholder="Compendium.mighty-blade.habilidades..." />
      </div>
    </div>

    {{!-- 3. ABA AVANÇO (ADVANCEMENT ESTILO D&D 5E) --}}
    <div class="tab advancement" data-group="primary" data-tab="advancement">
      <div class="advancement-panel">
        
        <div class="advancement-section-title">
          <i class="fas fa-sparkles"></i> ATRIBUTOS CONCEDIDOS PELA RAÇA
        </div>
        <div class="advancement-attrs-grid">
          <div class="adv-attr-box">
            <span class="adv-attr-label">FORÇA</span>
            <input type="number" name="system.atributos.forca" value="{{system.atributos.forca}}" class="adv-attr-input" />
          </div>
          <div class="adv-attr-box">
            <span class="adv-attr-label">AGILIDADE</span>
            <input type="number" name="system.atributos.agilidade" value="{{system.atributos.agilidade}}" class="adv-attr-input" />
          </div>
          <div class="adv-attr-box">
            <span class="adv-attr-label">INTELIGÊNCIA</span>
            <input type="number" name="system.atributos.inteligencia" value="{{system.atributos.inteligencia}}" class="adv-attr-input" />
          </div>
          <div class="adv-attr-box">
            <span class="adv-attr-label">VONTADE</span>
            <input type="number" name="system.atributos.vontade" value="{{system.atributos.vontade}}" class="adv-attr-input" />
          </div>
        </div>

        <div class="advancement-section-title" style="margin-top:16px;">
          <i class="fas fa-award"></i> HABILIDADE AUTOMÁTICA CONCEDIDA
        </div>
        <div class="adv-drop-zone drop-zone {{#if linkedAbility}}has-item{{/if}}">
          {{#if linkedAbility}}
            <div class="linked-item-pill">
              <img src="{{linkedAbility.img}}" width="32" height="32" />
              <div class="linked-item-text">
                <strong>{{linkedAbility.name}}</strong>
                <small>{{linkedAbility.system.tipo}} • {{linkedAbility.system.categoria}}</small>
              </div>
              <a class="remove-link" title="Remover Vínculo"><i class="fas fa-times"></i></a>
            </div>
          {{else}}
            <div class="placeholder-drop">
              <i class="fas fa-cloud-arrow-down"></i> Arraste uma Habilidade aqui para vincular
            </div>
          {{/if}}
        </div>

        {{#if advancementSteps.length}}
          <div class="advancement-section-title" style="margin-top:16px;">
            <i class="fas fa-sliders"></i> PASSOS DE AVANÇO & ESCOLHAS (PADRÃO D&D 5E)
          </div>
          <div class="advancement-steps-list">
            {{#each advancementSteps as |step|}}
              <div class="advancement-step-card">
                <div class="step-icon-box">
                  <i class="fas {{step.icone}}"></i>
                </div>
                <div class="step-info-box">
                  <strong>{{step.titulo}}</strong>
                  <small>{{step.descricao}}</small>
                </div>
              </div>
            {{/each}}
          </div>
        {{/if}}

        {{#if isEmbedded}}
          {{#if hasAdvancement}}
            <div class="advancement-active-box" style="margin-top:14px;">
              <div class="active-choice-header">
                <span><i class="fas fa-check-circle"></i> ESCOLHA ATIVA NO PERSONAGEM</span>
                <button type="button" class="reconfigure-item-advancement-btn adv-reconfig-btn" data-item-id="{{advancementTargetId}}">
                  <i class="fas fa-sliders"></i> Reconfigurar Escolha
                </button>
              </div>
              {{#if activeChoiceSummary}}
                <div class="active-choice-summary">{{activeChoiceSummary}}</div>
              {{/if}}
              {{#if activeTraitPills.length}}
                <div class="active-trait-pills">
                  {{#each activeTraitPills as |traitName|}}
                    <span class="trait-pill-dnd">{{traitName}}</span>
                  {{/each}}
                </div>
              {{/if}}
              {{#if activeSacrificeSummary}}
                <div class="active-sacrifice-note">{{activeSacrificeSummary}}</div>
              {{/if}}
            </div>
          {{/if}}
        {{/if}}

      </div>
    </div>

  </section>

</form>