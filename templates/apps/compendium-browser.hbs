<div class="compendium-browser flexrow">
  <section class="browser-sidebar">
    {{!-- Abas de Categorias --}}
    <nav class="browser-categories-bar" style="display:flex;gap:4px;margin-bottom:8px;overflow-x:auto;padding-bottom:4px;border-bottom:1px solid rgba(255,255,255,0.08);">
      {{#each categories}}
        <button
          type="button"
          class="browser-tab-btn {{#if this.active}}active{{/if}}"
          data-tab="{{this.id}}"
          style="padding:3px 8px;font-size:0.75rem;border-radius:12px;border:1px solid {{#if this.active}}#f59e0b{{else}}rgba(255,255,255,0.15){{/if}};background:{{#if this.active}}rgba(245,158,11,0.2){{else}}rgba(0,0,0,0.2){{/if}};color:{{#if this.active}}#fbbf24{{else}}#cbd5e1{{/if}};font-weight:{{#if this.active}}700{{else}}500{{/if}};cursor:pointer;white-space:nowrap;"
        >
          {{this.label}}
        </button>
      {{/each}}
    </nav>

    <div class="search-bar" style="display:flex;gap:6px;align-items:center;">
      <input
        type="text"
        name="search"
        placeholder="Buscar..."
        autocomplete="off"
        style="flex:1;"
      />
      <button
        type="button"
        class="sync-packs-button"
        title="Reconstruir e sincronizar compêndios com o catálogo canônico de regras"
        style="flex:0 0 auto;width:auto;padding:0 8px;height:28px;background:rgba(217,119,6,0.2);border:1px solid #d97706;color:#f59e0b;border-radius:4px;cursor:pointer;"
      >
        <i class="fas fa-arrows-rotate"></i>
      </button>
    </div>
    <ul class="item-list">
      {{#each items}}
        <li class="item flexrow" data-item-id="{{this.uuid}}">
          <img src="{{this.img}}" width="36" height="36" />
          <span class="item-name">{{this.name}}</span>
          <div class="item-controls">
            <input type="radio" name="selected-item" value="{{this.uuid}}" />
          </div>
        </li>
      {{/each}}
    </ul>
  </section>
  <section class="browser-details">
    <div class="details-header">
      <h2>Detalhes</h2>
    </div>
    <div class="details-content">
      <p class="instruction">Passe o mouse sobre um item para ver os detalhes.</p>
    </div>
    <div class="browser-footer">
      <div class="selection-status">
        <i class="fas fa-info-circle"></i>
        Selecione 1 opção
      </div>
      <button type="button" class="select-button" disabled>
        <i class="fas fa-check"></i>
        Selecionar
      </button>
    </div>
  </section>
</div>