<div class="compendium-browser" style="display:flex;flex-direction:column;height:100%;min-height:480px;overflow:hidden;gap:10px;">
  {{!-- Barra Superior Full-Width de Categorias (Sem Scroll Horizontal) --}}
  <nav class="browser-categories-bar" style="display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:6px;padding:5px 6px;background:rgba(15,23,42,0.85);border:1px solid rgba(255,255,255,0.1);border-radius:8px;flex-shrink:0;overflow:hidden;">
    {{#each categories}}
      <button
        type="button"
        class="browser-tab-btn {{#if this.active}}active{{/if}}"
        data-tab="{{this.id}}"
        style="flex:1 1 0 !important;width:auto !important;min-width:0 !important;height:32px !important;margin:0 !important;padding:0 8px !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;gap:6px !important;font-size:0.78rem !important;line-height:1 !important;border-radius:6px !important;border:1px solid {{#if this.active}}#f59e0b{{else}}rgba(255,255,255,0.12){{/if}} !important;background:{{#if this.active}}linear-gradient(180deg, rgba(245,158,11,0.28) 0%, rgba(217,119,6,0.18) 100%){{else}}rgba(15,23,42,0.6){{/if}} !important;color:{{#if this.active}}#fbbf24{{else}}#cbd5e1{{/if}} !important;font-weight:{{#if this.active}}700{{else}}500{{/if}} !important;cursor:pointer;white-space:nowrap;box-shadow:{{#if this.active}}0 0 10px rgba(245,158,11,0.2){{else}}none{{/if}};"
      >
        {{#if this.icon}}<i class="{{this.icon}}" style="font-size:0.76rem;opacity:{{#if this.active}}1{{else}}0.75{{/if}};"></i>{{/if}}
        <span style="overflow:hidden;text-overflow:ellipsis;">{{this.label}}</span>
      </button>
    {{/each}}
  </nav>

  {{#if hasSubTabs}}
    {{!-- Barra de Sub-Abas de Habilidades/Magias do Personagem --}}
    <nav class="browser-subtabs-bar" style="display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:8px;padding:4px 8px;background:rgba(15,23,42,0.65);border:1px solid rgba(255,255,255,0.08);border-radius:6px;flex-shrink:0;">
      <div class="subtabs-buttons" style="display:flex;flex-direction:row;align-items:center;gap:6px;overflow-x:auto;">
        {{#each subTabs}}
          <button
            type="button"
            class="browser-subtab-btn {{#if this.active}}active{{/if}}"
            data-subtab="{{this.id}}"
            style="padding:3px 10px;height:26px;border-radius:4px;border:1px solid {{#if this.active}}#f59e0b{{else}}rgba(255,255,255,0.1){{/if}};background:{{#if this.active}}rgba(245,158,11,0.22){{else}}rgba(15,23,42,0.4){{/if}};color:{{#if this.active}}#fbbf24{{else}}#94a3b8{{/if}};font-size:0.78rem;font-weight:{{#if this.active}}700{{else}}500{{/if}};cursor:pointer;white-space:nowrap;"
          >
            {{this.label}}
          </button>
        {{/each}}
      </div>
      <div style="display:flex;align-items:center;gap:10px;margin-left:auto;">
        {{#if showEspacos}}
          <span class="espacos-counter-badge" style="display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:4px;font-size:0.78rem;font-weight:700;background:{{#if limiteEsgotado}}rgba(239,68,68,0.2){{else}}rgba(16,185,129,0.15){{/if}};border:1px solid {{#if limiteEsgotado}}#ef4444{{else}}#10b981{{/if}};color:{{#if limiteEsgotado}}#f87171{{else}}#34d399{{/if}};" title="{{#if limiteEsgotado}}Sem espaços de habilidade neste nível{{else}}Espaços de habilidades e magias disponíveis no nível{{/if}}">
            <i class="fas {{#if limiteEsgotado}}fa-lock{{else}}fa-bolt{{/if}}"></i> Espaços: {{espacosTexto}}
          </span>
        {{/if}}
        <label class="browser-eligible-toggle" style="display:inline-flex;align-items:center;gap:6px;font-size:0.78rem;color:#cbd5e1;cursor:pointer;white-space:nowrap;user-select:none;">
          <input type="checkbox" name="only-eligible" {{#if onlyEligible}}checked{{/if}} style="cursor:pointer;margin:0;" />
          <span>Apenas elegíveis</span>
        </label>
      </div>
    </nav>
  {{/if}}

  {{!-- Corpo Principal: Lista à Esquerda + Detalhes à Direita --}}
  <div class="browser-body" style="display:flex;flex-direction:row;flex:1 1 auto;min-height:0;overflow:hidden;gap:12px;">
    <section class="browser-sidebar" style="flex:0 0 280px;width:280px;min-width:280px;max-width:280px;display:flex;flex-direction:column;border-right:1px solid rgba(255,255,255,0.1);padding-right:10px;overflow:hidden;">
      <div class="search-bar" style="display:flex;gap:6px;align-items:center;margin-bottom:8px;flex-shrink:0;">
        <input
          type="text"
          name="search"
          placeholder="Buscar..."
          autocomplete="off"
          style="flex:1;min-width:0;height:30px;padding:2px 10px;font-size:0.85rem;border-radius:6px;"
        />
        <button
          type="button"
          class="sync-packs-button"
          title="Reconstruir e sincronizar compêndios com o catálogo canônico de regras"
          style="flex:0 0 30px !important;width:30px !important;height:30px !important;margin:0 !important;padding:0 !important;background:rgba(217,119,6,0.2);border:1px solid #d97706;color:#f59e0b;border-radius:6px;cursor:pointer;display:flex;align-items:center;justify-content:center;"
        >
          <i class="fas fa-arrows-rotate"></i>
        </button>
      </div>
      <ul class="item-list" style="list-style:none;margin:0;padding:0;overflow-y:auto;flex:1 1 auto;">
        {{#each items}}
          <li
            class="item browser-item {{#if this.alreadyOwned}}already-owned{{else}}{{#unless this.meetsPrereq}}prereq-failed{{/unless}}{{/if}}"
            data-item-id="{{this.uuid}}"
            data-meets-prereq="{{this.meetsPrereq}}"
            data-already-owned="{{this.alreadyOwned}}"
            style="display:flex;align-items:center;gap:8px;padding:5px 6px;border-bottom:1px solid rgba(255,255,255,0.06);cursor:pointer;border-radius:4px;margin-bottom:2px;{{#if this.alreadyOwned}}opacity:0.5;background:rgba(100,116,139,0.08);{{else}}{{#unless this.meetsPrereq}}opacity:0.65;background:rgba(239,68,68,0.06);{{/unless}}{{/if}}"
          >
            <img
              src="{{this.img}}"
              alt="{{this.name}}"
              width="34"
              height="34"
              onerror="this.onerror=null;this.src='systems/mighty-blade/assets/icons/gear.svg';"
              style="flex:0 0 34px !important;width:34px !important;height:34px !important;min-width:34px !important;max-width:34px !important;min-height:34px !important;max-height:34px !important;object-fit:contain !important;border-radius:6px;display:block;border:1px solid rgba(255,255,255,0.08);background:rgba(15,23,42,0.6);"
            />
            <div class="item-text-info" style="flex:1 1 auto;min-width:0;display:flex;flex-direction:column;justify-content:center;">
              <span class="item-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.85rem;font-weight:600;color:{{#if this.alreadyOwned}}#94a3b8{{else}}{{#if this.meetsPrereq}}#f1f5f9{{else}}#cbd5e1{{/if}}{{/if}};">{{this.name}}</span>
              {{#if this.alreadyOwned}}
                <span class="owned-tag" style="font-size:0.68rem;color:#38bdf8;display:flex;align-items:center;gap:4px;margin-top:1px;font-weight:600;">
                  <i class="fas fa-check"></i> Já possui
                </span>
              {{else}}
                {{#unless this.meetsPrereq}}
                  <span class="prereq-tag" style="font-size:0.68rem;color:#f87171;display:flex;align-items:center;gap:4px;margin-top:1px;font-weight:600;">
                    <i class="fas fa-lock"></i> Requisitos pendentes
                  </span>
                {{/unless}}
              {{/if}}
            </div>
            <div class="item-controls" style="flex:0 0 auto;display:flex;align-items:center;">
              <input
                type="radio"
                name="selected-item"
                value="{{this.uuid}}"
                {{#if this.alreadyOwned}}disabled title="Já está na ficha"{{else}}{{#unless this.meetsPrereq}}disabled title="Pré-requisitos não atendidos"{{/unless}}{{/if}}
                style="cursor:{{#if this.alreadyOwned}}not-allowed{{else}}{{#if this.meetsPrereq}}pointer{{else}}not-allowed{{/if}}{{/if}};margin:0;"
              />
            </div>
          </li>
        {{/each}}
      </ul>
    </section>

    <section class="browser-details" style="flex:1 1 auto;min-width:0;display:flex;flex-direction:column;overflow:hidden;padding-left:4px;">
      <div class="details-header" style="border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:8px;padding-bottom:4px;flex-shrink:0;">
        <h2 style="margin:0;font-size:1.15rem;font-weight:700;color:#fbbf24;">Detalhes</h2>
      </div>
      <div class="details-content" style="flex:1 1 auto;overflow-y:auto;padding-right:6px;">
        <p class="instruction" style="font-style:italic;color:#94a3b8;text-align:center;margin-top:40px;">Passe o mouse sobre um item para ver os detalhes.</p>
      </div>
      <div class="browser-footer" style="margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.1);display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">
        <div class="selection-status" style="font-style:italic;color:#94a3b8;font-size:0.82rem;">
          {{#if limiteEsgotado}}
            <span style="color:#ef4444;"><i class="fas fa-lock"></i> Sem espaços de habilidade neste nível</span>
          {{else}}
            <i class="fas fa-info-circle"></i>
            Selecione 1 opção
          {{/if}}
        </div>
        <button type="button" class="select-button" disabled {{#if limiteEsgotado}}title="Sem espaços de habilidade neste nível"{{/if}} style="width:auto !important;min-width:140px !important;padding:6px 20px !important;border-radius:6px;font-weight:700;cursor:pointer;font-size:0.85rem;">
          <i class="fas fa-check"></i>
          Selecionar
        </button>
      </div>
    </section>
  </div>
</div>