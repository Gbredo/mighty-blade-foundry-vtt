<div class="spells-container-dnd">

  {{!-- Barra de Ações Superior --}}
  <div class="spells-tools-bar">
    <span class="spells-total-count">Grimório de Magias: <strong>{{magias.length}}</strong></span>
    <div class="spells-tools-actions">
      <a class="open-compendium-browser tool-btn" data-type="magia" title="Explorar Compêndio de Magias">
        <i class="fas fa-book-open"></i> Compêndio
      </a>
      <a class="item-create tool-btn create-btn" data-type="magia" title="Criar Nova Magia">
        <i class="fas fa-plus"></i> Nova Magia
      </a>
    </div>
  </div>

  {{!-- Lista de Magias com Header Estruturado --}}
  <section class="spells-group">
    <header class="group-header">
      <div class="group-title">
        <i class="fas fa-wand-magic-sparkles group-icon"></i>
        <span>MAGIAS CONHECIDAS ({{magias.length}})</span>
      </div>
      <div class="group-cols">
        <span class="col-head col-source">FONTE</span>
        <span class="col-head col-cost">CUSTO (PM)</span>
        <span class="col-head col-diff">DIFICULDADE (DV)</span>
        <span class="col-head col-actions">AÇÕES</span>
      </div>
    </header>
    <ul class="items-list-dnd">
      {{#each magias as |spell|}}
        <li class="item item-row-dnd spell-row" data-item-id="{{spell._id}}">
          <div class="item-main-col">
            <img src="{{spell.img}}" class="item-thumb-dnd rollable" data-roll-type="item" data-tooltip="Conjurar {{spell.name}} (Shift = Rápido)" />
            <div class="item-name-wrap">
              <h4 class="item-name-text rollable" data-roll-type="item">{{spell.name}}</h4>
              <span class="item-sub-desc">{{#if spell.system.circulo}}{{spell.system.circulo}}º Círculo • {{/if}}{{#if (eq spell.system.fonte "mistica")}}Fonte Mística{{else}}Fonte Arcana{{/if}}</span>
            </div>
          </div>
          <div class="item-stat-col col-source">
            <span class="badge-source {{spell.system.fonte}}">{{#if (eq spell.system.fonte "mistica")}}Mística{{else}}Arcana{{/if}}</span>
          </div>
          <div class="item-stat-col col-cost">
            <span class="badge-mana"><i class="fas fa-fire-flame-curved"></i> {{spell.system.custo}} PM</span>
          </div>
          <div class="item-stat-col col-diff">
            <span class="badge-diff">{{spell.displayDificuldade}}</span>
          </div>
          <div class="item-stat-col col-actions">
            <a class="rollable action-cast-btn" data-roll-type="item" data-tooltip="Conjurar Magia">
              <i class="fas fa-bolt"></i>
            </a>
            <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if spell.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
            <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
            {{#if ../flags.mighty-blade.isEditing}}
              <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <li class="empty-group-row">
          <span>Nenhuma magia conhecida neste grimório.</span>
        </li>
      {{/each}}
    </ul>
  </section>

</div>
