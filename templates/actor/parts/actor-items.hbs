<div class="inventory-container-dnd">

  {{!-- ═══════════════════════════════════════════════════════════
        BARRA SUPERIOR: CARGA & MOEDAS (ESTILO D&D 5E)
  ════════════════════════════════════════════════════════════════ --}}
  <div class="inventory-top-summary">
    
    {{!-- 1. Barra de Carga & Encumbrance --}}
    <div class="encumbrance-card {{#if isEncumberedMax}}is-encumbered-max{{else if isOverloaded}}is-overloaded{{/if}}">
      <div class="encumbrance-header">
        <span class="enc-label"><i class="fas fa-weight-hanging"></i> CAPACIDADE DE CARGA</span>
        <span class="enc-values">
          <strong>{{system.subattributes.carga.value}} kg</strong> / {{system.subattributes.carga.max}} kg
          <small class="enc-max-abs">(Máx: {{system.subattributes.carga.maxAbsoluto}} kg)</small>
        </span>
      </div>
      <div class="encumbrance-track-bar">
        <div
          class="encumbrance-fill-bar {{#if isEncumberedMax}}fill-danger{{else if isOverloaded}}fill-warning{{else}}fill-normal{{/if}}"
          style="width: {{cargaPct}}%;"
        ></div>
      </div>
      <div class="encumbrance-meta-row">
        <span>Básica: <strong>FOR × 5</strong></span>
        <span>Máxima: <strong>FOR × 10</strong></span>
        {{#if isOverloaded}}
          <span class="enc-warning-badge"><i class="fas fa-triangle-exclamation"></i> Penalidade de Carga</span>
        {{/if}}
      </div>
    </div>

    {{!-- 2. Carteira de Moedas (Moedas de Prata, Ouro e Cobre) --}}
    <div class="currencies-card">
      <div class="currency-badge currency-gold" data-tooltip="Moedas de Ouro (1 MO = 10 MP)">
        <i class="fas fa-coins coin-gold-icon"></i>
        <span class="currency-val">{{moedas.ouro}}</span>
        <span class="currency-tag">MO</span>
      </div>
      <div class="currency-badge currency-silver" data-tooltip="Moedas de Prata (Moeda Padrão de Drakon)">
        <i class="fas fa-circle-dot coin-silver-icon"></i>
        <input
          type="number"
          name="system.details.dinheiro"
          value="{{system.details.dinheiro}}"
          class="currency-input"
          data-tooltip="Total de Dinheiro (Moedas de Prata)"
        />
        <span class="currency-tag">MP</span>
      </div>
      <div class="currency-badge currency-copper" data-tooltip="Moedas de Cobre (10 MC = 1 MP)">
        <i class="fas fa-circle-dot coin-copper-icon"></i>
        <span class="currency-val">{{moedas.cobre}}</span>
        <span class="currency-tag">MC</span>
      </div>
    </div>

  </div>

  {{!-- ═══════════════════════════════════════════════════════════
        BARRA DE FERRAMENTAS DO INVENTÁRIO (BUSCA & COMPÊNDIO)
  ════════════════════════════════════════════════════════════════ --}}
  <div class="inventory-tools-bar">
    <div class="inventory-search-wrap">
      <i class="fas fa-search search-icon"></i>
      <input type="text" class="inventory-search-input" placeholder="Buscar no inventário..." />
    </div>
    <div class="inventory-tools-actions">
      <a class="open-compendium-browser tool-btn" data-type="equipamento" title="Explorar Compêndio de Equipamentos">
        <i class="fas fa-book-open"></i> Compêndio
      </a>
      {{#if flags.mighty-blade.isEditing}}
        <a class="item-create tool-btn create-btn" data-type="equipamento" title="Criar Novo Item">
          <i class="fas fa-plus"></i> Novo Item
        </a>
      {{/if}}
    </div>
  </div>

  {{!-- ═══════════════════════════════════════════════════════════
        CATEGORIAS ESTRUTURADAS DE ITENS (ESTILO D&D 5E)
  ════════════════════════════════════════════════════════════════ --}}

  {{!-- 1. ARMAS --}}
  <section class="inventory-group weapons-group">
    <header class="group-header">
      <div class="group-title">
        <i class="fas fa-swords group-icon"></i>
        <span>ARMAS ({{weapons.length}})</span>
      </div>
      <div class="group-cols">
        <span class="col-head col-weight">PESO</span>
        <span class="col-head col-qty">QTD</span>
        <span class="col-head col-formula">DANO / FÓRMULA</span>
        <span class="col-head col-equip">EQUIP.</span>
        <span class="col-head col-actions">AÇÕES</span>
      </div>
    </header>
    <ul class="items-list-dnd">
      {{#each weapons as |item|}}
        <li class="item item-row-dnd {{#if item.system.equipado}}is-equipped{{/if}}" data-item-id="{{item._id}}">
          <div class="item-main-col">
            <img src="{{item.img}}" class="item-thumb-dnd rollable" data-roll-type="item" data-tooltip="Rolar Ataque com {{item.name}}" />
            <div class="item-name-wrap">
              <h4 class="item-name-text rollable" data-roll-type="item">{{item.name}}</h4>
              <span class="item-sub-desc">{{item.system.alcance}} • FN {{item.system.fn}}</span>
            </div>
          </div>
          <div class="item-stat-col col-weight">{{item.system.peso}} kg</div>
          <div class="item-stat-col col-qty">
            <a class="item-qty-minus stepper-btn" data-tooltip="Diminuir">-</a>
            <span class="qty-num">{{item.system.quantidade}}</span>
            <a class="item-qty-plus stepper-btn" data-tooltip="Aumentar">+</a>
          </div>
          <div class="item-stat-col col-formula">
            <span class="badge-dano">{{item.system.dano}}</span>
          </div>
          <div class="item-stat-col col-equip">
            <a class="item-equip equip-toggle-btn {{#if item.system.equipado}}equipped-active{{/if}}" data-tooltip="{{#if item.system.equipado}}Equipado (clique para guardar){{else}}Guardado (clique para empunhar){{/if}}">
              <i class="fas {{#if item.system.equipado}}fa-shield-halved{{else}}fa-circle{{/if}}"></i>
            </a>
          </div>
          <div class="item-stat-col col-actions">
            <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if item.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
            <a class="item-edit" data-tooltip="Editar Arma"><i class="fas fa-edit"></i></a>
            {{#if ../flags.mighty-blade.isEditing}}
              <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <li class="empty-group-row">
          <span>Nenhuma arma no inventário.</span>
        </li>
      {{/each}}
    </ul>
  </section>

  {{!-- 2. ARMADURAS & ESCUDOS --}}
  <section class="inventory-group armor-group">
    <header class="group-header">
      <div class="group-title">
        <i class="fas fa-shield-halved group-icon"></i>
        <span>ARMADURAS & ESCUDOS ({{armors.length}})</span>
      </div>
      <div class="group-cols">
        <span class="col-head col-weight">PESO</span>
        <span class="col-head col-qty">QTD</span>
        <span class="col-head col-formula">DEFESA / FN</span>
        <span class="col-head col-equip">EQUIP.</span>
        <span class="col-head col-actions">AÇÕES</span>
      </div>
    </header>
    <ul class="items-list-dnd">
      {{#each armors as |item|}}
        <li class="item item-row-dnd {{#if item.system.equipado}}is-equipped{{/if}}" data-item-id="{{item._id}}">
          <div class="item-main-col">
            <img src="{{item.img}}" class="item-thumb-dnd" />
            <div class="item-name-wrap">
              <h4 class="item-name-text">{{item.name}}</h4>
              <span class="item-sub-desc">{{#if (eq item.system.subtipo "escudo")}}Escudo{{else}}Armadura{{/if}}{{#if item.system.pesada}} • Pesada{{/if}}</span>
            </div>
          </div>
          <div class="item-stat-col col-weight">{{item.system.peso}} kg</div>
          <div class="item-stat-col col-qty">
            <a class="item-qty-minus stepper-btn">-</a>
            <span class="qty-num">{{item.system.quantidade}}</span>
            <a class="item-qty-plus stepper-btn">+</a>
          </div>
          <div class="item-stat-col col-formula">
            <span class="badge-defesa">+{{item.system.defesa}} DEF (FN {{item.system.fn}})</span>
          </div>
          <div class="item-stat-col col-equip">
            <a class="item-equip equip-toggle-btn {{#if item.system.equipado}}equipped-active{{/if}}" data-tooltip="{{#if item.system.equipado}}Equipado (clique para guardar){{else}}Guardado (clique para vestir){{/if}}">
              <i class="fas {{#if item.system.equipado}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
            </a>
          </div>
          <div class="item-stat-col col-actions">
            <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if item.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
            <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
            {{#if ../flags.mighty-blade.isEditing}}
              <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <li class="empty-group-row">
          <span>Nenhuma armadura ou escudo no inventário.</span>
        </li>
      {{/each}}
    </ul>
  </section>

  {{!-- 3. CONSUMÍVEIS, POÇÕES & ELIXIRES --}}
  <section class="inventory-group consumables-group">
    <header class="group-header">
      <div class="group-title">
        <i class="fas fa-flask-round-potion group-icon"></i>
        <span>CONSUMÍVEIS & POÇÕES ({{consumables.length}})</span>
      </div>
      <div class="group-cols">
        <span class="col-head col-weight">PESO</span>
        <span class="col-head col-qty">QTD</span>
        <span class="col-head col-formula">CUSTO</span>
        <span class="col-head col-equip">USAR</span>
        <span class="col-head col-actions">AÇÕES</span>
      </div>
    </header>
    <ul class="items-list-dnd">
      {{#each consumables as |item|}}
        <li class="item item-row-dnd" data-item-id="{{item._id}}">
          <div class="item-main-col">
            <img src="{{item.img}}" class="item-thumb-dnd rollable" data-roll-type="item" data-tooltip="Usar {{item.name}}" />
            <div class="item-name-wrap">
              <h4 class="item-name-text rollable" data-roll-type="item">{{item.name}}</h4>
              <span class="item-sub-desc">Consumível</span>
            </div>
          </div>
          <div class="item-stat-col col-weight">{{item.system.peso}} kg</div>
          <div class="item-stat-col col-qty">
            <a class="item-qty-minus stepper-btn">-</a>
            <span class="qty-num">{{item.system.quantidade}}</span>
            <a class="item-qty-plus stepper-btn">+</a>
          </div>
          <div class="item-stat-col col-formula">{{item.system.custo}} MP</div>
          <div class="item-stat-col col-equip">
            <a class="rollable action-use-btn" data-roll-type="item" data-tooltip="Usar / Beber Poção">
              <i class="fas fa-sparkles"></i> Usar
            </a>
          </div>
          <div class="item-stat-col col-actions">
            <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if item.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
            <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
            {{#if ../flags.mighty-blade.isEditing}}
              <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <li class="empty-group-row">
          <span>Nenhum consumível no inventário.</span>
        </li>
      {{/each}}
    </ul>
  </section>

  {{!-- 4. EQUIPAMENTOS GERAIS --}}
  <section class="inventory-group gear-group">
    <header class="group-header">
      <div class="group-title">
        <i class="fas fa-toolbox group-icon"></i>
        <span>EQUIPAMENTOS GERAIS ({{equipmentList.length}})</span>
      </div>
      <div class="group-cols">
        <span class="col-head col-weight">PESO</span>
        <span class="col-head col-qty">QTD</span>
        <span class="col-head col-formula">CUSTO</span>
        <span class="col-head col-equip">ESTADO</span>
        <span class="col-head col-actions">AÇÕES</span>
      </div>
    </header>
    <ul class="items-list-dnd">
      {{#each equipmentList as |item|}}
        <li class="item item-row-dnd {{#if item.system.equipado}}is-equipped{{/if}}" data-item-id="{{item._id}}">
          <div class="item-main-col">
            <img src="{{item.img}}" class="item-thumb-dnd" />
            <div class="item-name-wrap">
              <h4 class="item-name-text">{{item.name}}</h4>
              <span class="item-sub-desc">Equipamento Utilitário</span>
            </div>
          </div>
          <div class="item-stat-col col-weight">{{item.system.peso}} kg</div>
          <div class="item-stat-col col-qty">
            <a class="item-qty-minus stepper-btn">-</a>
            <span class="qty-num">{{item.system.quantidade}}</span>
            <a class="item-qty-plus stepper-btn">+</a>
          </div>
          <div class="item-stat-col col-formula">{{item.system.custo}} MP</div>
          <div class="item-stat-col col-equip">
            <a class="item-equip equip-toggle-btn {{#if item.system.equipado}}equipped-active{{/if}}" data-tooltip="{{#if item.system.equipado}}Equipado{{else}}Guardado na Mochila{{/if}}">
              <i class="fas {{#if item.system.equipado}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
            </a>
          </div>
          <div class="item-stat-col col-actions">
            <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if item.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
            <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
            {{#if ../flags.mighty-blade.isEditing}}
              <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <li class="empty-group-row">
          <span>Nenhum equipamento geral no inventário.</span>
        </li>
      {{/each}}
    </ul>
  </section>

</div>