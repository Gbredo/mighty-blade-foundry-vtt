<div class="features-container-dnd">

  {{!-- Barra de Ações Superior --}}
  <div class="features-tools-bar">
    <span class="features-total-count">Total de Habilidades: <strong>{{features.length}}</strong></span>
    <div class="features-tools-actions">
      <a class="open-compendium-browser tool-btn" data-type="habilidade" title="Explorar Compêndio de Habilidades">
        <i class="fas fa-book-open"></i> Compêndio
      </a>
      <a class="item-create tool-btn create-btn" data-type="habilidade" title="Criar Nova Habilidade">
        <i class="fas fa-plus"></i> Nova Habilidade
      </a>
    </div>
  </div>

  {{!-- 1. HABILIDADES RACIAIS --}}
  {{#if racialFeatures.length}}
    <section class="feature-group racial-features-group">
      <header class="feature-group-header">
        <div class="feature-group-title">
          <i class="fas fa-user-shield group-icon"></i>
          <span>HABILIDADES RACIAIS ({{racialFeatures.length}})</span>
        </div>
      </header>
      <ul class="features-list-dnd">
        {{#each racialFeatures as |feat|}}
          <li class="item feature-row-dnd {{#if feat.isSubFeature}}feature-subrow-dnd{{/if}} {{#if feat.isLastSubFeature}}is-last-subrow{{/if}} {{#if feat.hasChildren}}feature-parent-row-dnd{{/if}}" data-item-id="{{feat._id}}">
            <div class="feature-main-col">
              {{#if feat.isSubFeature}}
                <span class="subfeature-tree-branch" aria-hidden="true">{{#if feat.isLastSubFeature}}└─{{else}}├─{{/if}}</span>
              {{/if}}
              <img src="{{feat.img}}" class="feature-thumb rollable" data-roll-type="item" data-tooltip="Usar {{feat.name}}" />
              <div class="feature-name-wrap">
                <div class="feature-title-line">
                  <h4 class="feature-name-text rollable" data-roll-type="item">{{feat.name}}</h4>
                  {{#if feat.originLabel}}
                    <span class="badge-origin-dnd">{{feat.originLabel}}</span>
                  {{/if}}
                  {{#if feat.advancementSummary}}
                    <span class="badge-advancement-choice">{{feat.advancementSummary}}</span>
                  {{/if}}
                </div>
                <span class="feature-sub-desc">{{feat.system.tipo}} • {{feat.system.categoria}}</span>
              </div>
            </div>
            <div class="feature-cost-col">
              {{#if feat.system.custo}}
                <span class="badge-mana"><i class="fas fa-fire-flame-curved"></i> {{feat.system.custo}} PM</span>
              {{else}}
                <span class="badge-free">Passiva / Sem Custo</span>
              {{/if}}
            </div>
            <div class="feature-actions-col">
              {{#if feat.hasAdvancement}}
                <a class="reconfigure-advancement-btn" data-item-id="{{feat._id}}" data-tooltip="Reconfigurar Escolha (Avanço)"><i class="fas fa-sliders"></i></a>
              {{/if}}
              <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if feat.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
              <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
              {{#if ../flags.mighty-blade.isEditing}}
                <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  {{!-- 2. HABILIDADES DE CLASSE --}}
  {{#if classFeatures.length}}
    <section class="feature-group class-features-group">
      <header class="feature-group-header">
        <div class="feature-group-title">
          <i class="fas fa-shield-halved group-icon"></i>
          <span>HABILIDADES DE CLASSE ({{classFeatures.length}})</span>
        </div>
      </header>
      <ul class="features-list-dnd">
        {{#each classFeatures as |feat|}}
          <li class="item feature-row-dnd" data-item-id="{{feat._id}}">
            <div class="feature-main-col">
              <img src="{{feat.img}}" class="feature-thumb rollable" data-roll-type="item" data-tooltip="Usar {{feat.name}}" />
              <div class="feature-name-wrap">
                <div class="feature-title-line">
                  <h4 class="feature-name-text rollable" data-roll-type="item">{{feat.name}}</h4>
                  {{#if feat.advancementSummary}}
                    <span class="badge-advancement-choice">{{feat.advancementSummary}}</span>
                  {{/if}}
                </div>
                <span class="feature-sub-desc">{{feat.system.tipo}} • {{feat.system.categoria}}</span>
              </div>
            </div>
            <div class="feature-cost-col">
              {{#if feat.system.custo}}
                <span class="badge-mana"><i class="fas fa-fire-flame-curved"></i> {{feat.system.custo}} PM</span>
              {{else}}
                <span class="badge-free">Passiva / Sem Custo</span>
              {{/if}}
            </div>
            <div class="feature-actions-col">
              {{#if feat.hasAdvancement}}
                <a class="reconfigure-advancement-btn" data-item-id="{{feat._id}}" data-tooltip="Reconfigurar Escolha (Avanço)"><i class="fas fa-sliders"></i></a>
              {{/if}}
              <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if feat.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
              <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
              {{#if ../flags.mighty-blade.isEditing}}
                <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  {{!-- 3. HABILIDADES DE CAMINHO --}}
  {{#if pathFeatures.length}}
    <section class="feature-group path-features-group">
      <header class="feature-group-header">
        <div class="feature-group-title">
          <i class="fas fa-route group-icon"></i>
          <span>HABILIDADES DE CAMINHO ({{pathFeatures.length}})</span>
        </div>
      </header>
      <ul class="features-list-dnd">
        {{#each pathFeatures as |feat|}}
          <li class="item feature-row-dnd" data-item-id="{{feat._id}}">
            <div class="feature-main-col">
              <img src="{{feat.img}}" class="feature-thumb rollable" data-roll-type="item" data-tooltip="Usar {{feat.name}}" />
              <div class="feature-name-wrap">
                <h4 class="feature-name-text rollable" data-roll-type="item">{{feat.name}}</h4>
                <span class="feature-sub-desc">{{feat.system.tipo}} • {{feat.system.categoria}}</span>
              </div>
            </div>
            <div class="feature-cost-col">
              {{#if feat.system.custo}}
                <span class="badge-mana"><i class="fas fa-fire-flame-curved"></i> {{feat.system.custo}} PM</span>
              {{else}}
                <span class="badge-free">Passiva / Sem Custo</span>
              {{/if}}
            </div>
            <div class="feature-actions-col">
              <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if feat.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
              <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
              {{#if ../flags.mighty-blade.isEditing}}
                <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

  {{!-- 4. HABILIDADES GERAIS & TÉCNICAS --}}
  <section class="feature-group general-features-group">
    <header class="feature-group-header">
      <div class="feature-group-title">
        <i class="fas fa-sparkles group-icon"></i>
        <span>HABILIDADES GERAIS & TÉCNICAS ({{generalFeatures.length}})</span>
      </div>
    </header>
    <ul class="features-list-dnd">
      {{#each generalFeatures as |feat|}}
        <li class="item feature-row-dnd" data-item-id="{{feat._id}}">
          <div class="feature-main-col">
            <img src="{{feat.img}}" class="feature-thumb rollable" data-roll-type="item" data-tooltip="Usar {{feat.name}}" />
            <div class="feature-name-wrap">
              <div class="feature-title-line">
                <h4 class="feature-name-text rollable" data-roll-type="item">{{feat.name}}</h4>
                {{#if feat.advancementSummary}}
                  <span class="badge-advancement-choice">{{feat.advancementSummary}}</span>
                {{/if}}
              </div>
              <span class="feature-sub-desc">{{feat.system.tipo}} • {{feat.system.categoria}}</span>
            </div>
          </div>
          <div class="feature-cost-col">
            {{#if feat.system.custo}}
              <span class="badge-mana"><i class="fas fa-fire-flame-curved"></i> {{feat.system.custo}} PM</span>
            {{else}}
              <span class="badge-free">Passiva / Sem Custo</span>
            {{/if}}
          </div>
          <div class="feature-actions-col">
            {{#if feat.hasAdvancement}}
              <a class="reconfigure-advancement-btn" data-item-id="{{feat._id}}" data-tooltip="Reconfigurar Escolha (Avanço)"><i class="fas fa-sliders"></i></a>
            {{/if}}
            <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if feat.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
            <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
            {{#if ../flags.mighty-blade.isEditing}}
              <a class="item-delete" data-tooltip="Excluir"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <li class="empty-group-row">
          <span>Nenhuma outra habilidade registrada.</span>
        </li>
      {{/each}}
    </ul>
  </section>

</div>