<form class="{{cssClass}} mb-sheet-dark" autocomplete="off">

  {{!-- ═══════════════════════════════════════════════════════════
        CABEÇALHO & IDENTIDADE HEROICA
  ════════════════════════════════════════════════════════════════ --}}
  <header class="sheet-header">
    
    {{!-- Coluna do Avatar / Token --}}
    <div class="header-avatar-col">
      <div class="avatar-frame">
        <img
          class="profile-img"
          src="{{actor.img}}"
          data-edit="img"
          title="{{actor.name}}"
        />
      </div>
      <div class="level-badge" title="Nível e Experiência">
        <span class="level-num">Nv. {{system.details.nivel}}</span>
        <span class="xp-val">{{system.details.experiencia}} XP</span>
      </div>
    </div>

    {{!-- Campos Centrais da Ficha --}}
    <div class="header-fields">
      
      {{!-- Linha do Nome e Ações do Cabeçalho --}}
      <div class="charname-row">
        <h1 class="charname">
          <input
            name="name"
            type="text"
            value="{{actor.name}}"
            placeholder="Nome do Herói"
          />
        </h1>
        <div class="sheet-config-container">
          <a class="sheet-config {{#if flags.mighty-blade.isEditing}}editing{{/if}}" title="{{#if flags.mighty-blade.isEditing}}Salvar Alterações (Travar Ficha){{else}}Habilitar Edição Manual{{/if}}">
            <i class="fas {{#if flags.mighty-blade.isEditing}}fa-check-circle{{else}}fa-gear{{/if}}"></i>
          </a>
        </div>
      </div>

      {{!-- Grid 2x2 Simétrico Canônico: Raça, Classe, Caminho, Organização --}}
      <div class="identity-grid-2x2">
        
        {{!-- 1. RAÇA --}}
        <div class="id-card id-card-raca">
          <span class="id-label"><i class="fas fa-user"></i> Raça</span>
          <div class="id-content">
            {{#if raca}}
              <div class="item id-item-pill" data-item-id="{{raca._id}}">
                <span class="item-name" data-tooltip="<strong>Classes Comuns:</strong> {{raca.system.classesComuns}}">{{raca.name}}</span>
                <div class="item-controls">
                  <a class="item-control item-replace" title="Trocar Raça" data-type="raca"><i class="fas fa-exchange-alt"></i></a>
                  <a class="item-control item-edit" title="Editar Raça"><i class="fas fa-edit"></i></a>
                  {{#if flags.mighty-blade.isEditing}}
                  <a class="item-control item-delete" title="Remover"><i class="fas fa-trash"></i></a>
                  {{/if}}
                </div>
              </div>
            {{else}}
              <a class="item-create placeholder-btn" data-type="raca">
                <i class="fas fa-plus"></i> Escolher Raça
              </a>
            {{/if}}
          </div>
        </div>

        {{!-- 2. CLASSE (COM APRENDIZ ANINHADO) --}}
        <div class="id-card id-card-classe">
          <span class="id-label"><i class="fas fa-shield-halved"></i> Classe</span>
          <div class="id-content">
            {{#if classe}}
              <div class="item id-item-pill" data-item-id="{{classe._id}}">
                <span class="item-name">{{classe.name}}</span>
                <div class="item-controls">
                  <a class="item-control item-replace" title="Trocar Classe" data-type="classe"><i class="fas fa-exchange-alt"></i></a>
                  <a class="item-control item-edit" title="Editar Classe"><i class="fas fa-edit"></i></a>
                  {{#if flags.mighty-blade.isEditing}}
                  <a class="item-control item-delete" title="Remover"><i class="fas fa-trash"></i></a>
                  {{/if}}
                </div>
              </div>
            {{else}}
              <a class="item-create placeholder-btn" data-type="classe">
                <i class="fas fa-plus"></i> Escolher Classe
              </a>
            {{/if}}

            {{!-- Sub-badge de Aprendiz (quando houver) --}}
            {{#if flags.mighty-blade.isEditing}}
              <div class="aprendiz-input-row" title="Classe Secundária de Aprendiz">
                <span class="aprendiz-prefix">↳ Aprendiz:</span>
                <input
                  type="text"
                  name="system.details.aprendiz"
                  value="{{system.details.aprendiz}}"
                  placeholder="Nenhum"
                  class="aprendiz-input"
                />
              </div>
            {{else}}
              {{#if system.details.aprendiz}}
                <div class="aprendiz-badge" title="Aprendiz de Classe">
                  ↳ Aprendiz: <strong>{{#if formattedAprendiz}}{{formattedAprendiz}}{{else}}{{system.details.aprendiz}}{{/if}}</strong>
                </div>
              {{/if}}
            {{/if}}
          </div>
        </div>

        {{!-- 3. CAMINHO HEROICO --}}
        <div class="id-card id-card-caminho">
          <span class="id-label"><i class="fas fa-route"></i> Caminho</span>
          <div class="id-content">
            {{#if flags.mighty-blade.isEditing}}
              <input
                type="text"
                name="system.details.caminho"
                value="{{system.details.caminho}}"
                placeholder="Ex: Dracomante, Algoz..."
                class="id-text-input"
              />
            {{else}}
              <span class="id-value-text {{#unless system.details.caminho}}is-empty{{/unless}}">
                {{#if formattedCaminho}}{{formattedCaminho}}{{else}}{{#if system.details.caminho}}{{system.details.caminho}}{{else}}—{{/if}}{{/if}}
              </span>
            {{/if}}
          </div>
        </div>

        {{!-- 4. ORGANIZAÇÃO DE DRAKON --}}
        <div class="id-card id-card-organizacao">
          <span class="id-label"><i class="fas fa-landmark"></i> Organização</span>
          <div class="id-content">
            {{#if flags.mighty-blade.isEditing}}
              <input
                type="text"
                name="system.details.organizacao"
                value="{{system.details.organizacao}}"
                placeholder="Ex: Irmandade do Anel de Bronze..."
                class="id-text-input"
              />
            {{else}}
              <span class="id-value-text {{#unless system.details.organizacao}}is-empty{{/unless}}">
                {{#if formattedOrganizacao}}{{formattedOrganizacao}}{{else}}{{#if system.details.organizacao}}{{system.details.organizacao}}{{else}}—{{/if}}{{/if}}
              </span>
            {{/if}}
          </div>
        </div>

      </div>

      {{!-- Antecedentes & Progressão Rápida --}}
      <div class="header-sub-bar">
        <div class="antecedente-tags-container">
          <span class="sub-bar-label">Antecedente:</span>
          {{#if antecedentes.length}}
            {{#each antecedentes as |ant|}}
              <span class="antecedente-tag item" data-item-id="{{ant._id}}">
                {{ant.name}}
                <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
                {{#if ../flags.mighty-blade.isEditing}}
                <a class="item-control item-delete" title="Excluir"><i class="fas fa-trash"></i></a>
                {{/if}}
              </span>
            {{/each}}
          {{else}}
            <span class="text-muted-italic">Nenhum</span>
          {{/if}}
        </div>

        {{#if flags.mighty-blade.isEditing}}
          <div class="level-xp-edit-group">
            <label>Nível:</label>
            <input type="number" name="system.details.nivel" value="{{system.details.nivel}}" style="width:50px;" />
            <label>XP:</label>
            <input type="number" name="system.details.experiencia" value="{{system.details.experiencia}}" style="width:60px;" />
          </div>
        {{/if}}
      </div>

    </div>
  </header>

  {{!-- ═══════════════════════════════════════════════════════════
        BARRA DE ABAS DE NAVEGAÇÃO
  ════════════════════════════════════════════════════════════════ --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributes"><i class="fas fa-dice-d6"></i> Atributos</a>
    <a class="item" data-tab="items"><i class="fas fa-shield-halved"></i> Equipamentos</a>
    <a class="item" data-tab="features"><i class="fas fa-sparkles"></i> Habilidades</a>
    <a class="item" data-tab="spells"><i class="fas fa-wand-magic-sparkles"></i> Magias</a>
    <a class="item" data-tab="effects"><i class="fas fa-bolt"></i> Efeitos</a>
  </nav>

  {{!-- ═══════════════════════════════════════════════════════════
        CORPO DA FICHA
  ════════════════════════════════════════════════════════════════ --}}
  <section class="sheet-body">

    {{!-- ───────────────────────────────────────────────────────────
          ABA 1: ATRIBUTOS, COMBATE & RECURSOS
    ─────────────────────────────────────────────────────────────── --}}
    <div class="tab attributes" data-group="primary" data-tab="attributes">
      
      {{!-- 4 CARDS TÁTEIS DE ATRIBUTOS COM ROLAGEM DIRETA --}}
      <section class="attributes-boxes-grid">
        
        {{!-- FORÇA --}}
        <div class="attr-card rollable" data-roll-type="attribute" data-attribute="forca" title="Rolar Teste de Força (3d6 + Força)">
          <div class="attr-card-header">
            <span class="attr-name">{{localize "MB.Forca"}}</span>
            <i class="fas fa-dice-d6 attr-dice-icon"></i>
          </div>
          <div class="attr-card-body">
            {{#if flags.mighty-blade.isEditing}}
              <input
                type="text"
                name="system.attributes.forca.base"
                value="{{system.attributes.forca.base}}"
                data-dtype="Number"
                placeholder="Base"
                class="attr-input"
              />
            {{else}}
              <span class="attr-number">{{system.attributes.forca.value}}</span>
            {{/if}}
          </div>
          <span class="attr-badge-sub">3d6 + FOR</span>
        </div>

        {{!-- AGILIDADE --}}
        <div class="attr-card rollable" data-roll-type="attribute" data-attribute="agilidade" title="Rolar Teste de Agilidade (3d6 + Agilidade)">
          <div class="attr-card-header">
            <span class="attr-name">{{localize "MB.Agilidade"}}</span>
            <i class="fas fa-dice-d6 attr-dice-icon"></i>
          </div>
          <div class="attr-card-body">
            {{#if flags.mighty-blade.isEditing}}
              <input
                type="text"
                name="system.attributes.agilidade.base"
                value="{{system.attributes.agilidade.base}}"
                data-dtype="Number"
                placeholder="Base"
                class="attr-input"
              />
            {{else}}
              <span class="attr-number">{{system.attributes.agilidade.value}}</span>
            {{/if}}
          </div>
          <span class="attr-badge-sub">3d6 + AGI</span>
        </div>

        {{!-- INTELIGÊNCIA --}}
        <div class="attr-card rollable" data-roll-type="attribute" data-attribute="inteligencia" title="Rolar Teste de Inteligência (3d6 + Inteligência)">
          <div class="attr-card-header">
            <span class="attr-name">{{localize "MB.Inteligencia"}}</span>
            <i class="fas fa-dice-d6 attr-dice-icon"></i>
          </div>
          <div class="attr-card-body">
            {{#if flags.mighty-blade.isEditing}}
              <input
                type="text"
                name="system.attributes.inteligencia.base"
                value="{{system.attributes.inteligencia.base}}"
                data-dtype="Number"
                placeholder="Base"
                class="attr-input"
              />
            {{else}}
              <span class="attr-number">{{system.attributes.inteligencia.value}}</span>
            {{/if}}
          </div>
          <span class="attr-badge-sub">3d6 + INT</span>
        </div>

        {{!-- VONTADE --}}
        <div class="attr-card rollable" data-roll-type="attribute" data-attribute="vontade" title="Rolar Teste de Vontade (3d6 + Vontade)">
          <div class="attr-card-header">
            <span class="attr-name">{{localize "MB.Vontade"}}</span>
            <i class="fas fa-dice-d6 attr-dice-icon"></i>
          </div>
          <div class="attr-card-body">
            {{#if flags.mighty-blade.isEditing}}
              <input
                type="text"
                name="system.attributes.vontade.base"
                value="{{system.attributes.vontade.base}}"
                data-dtype="Number"
                placeholder="Base"
                class="attr-input"
              />
            {{else}}
              <span class="attr-number">{{system.attributes.vontade.value}}</span>
            {{/if}}
          </div>
          <span class="attr-badge-sub">3d6 + VON</span>
        </div>

      </section>

      {{!-- RECURSOS VITAIS (VIDA E MANA) COM BARRAS COLORIDAS --}}
      <section class="resources-bars-section">
        
        {{!-- PONTOS DE VIDA (CARMESIM) --}}
        <div class="resource-panel resource-panel-vida">
          <div class="resource-panel-header">
            <span class="res-title"><i class="fas fa-heart"></i> Pontos de Vida (PV)</span>
            <div class="res-inputs-group">
              <input
                type="text"
                name="system.resources.vida.value"
                value="{{system.resources.vida.value}}"
                data-dtype="Number"
                class="res-input-current"
                title="Vida Atual"
              />
              <span class="res-slash">/</span>
              <input
                type="text"
                name="system.resources.vida.max"
                value="{{system.resources.vida.max}}"
                data-dtype="Number"
                class="res-input-max"
                title="Vida Máxima"
              />
            </div>
          </div>
          <div class="resource-track">
            <div class="resource-fill fill-vida" style="width: {{#if vidaPct}}{{vidaPct}}{{else}}100{{/if}}%;"></div>
          </div>
        </div>

        {{!-- PONTOS DE MANA (AMETISTA / AZUL) --}}
        <div class="resource-panel resource-panel-mana">
          <div class="resource-panel-header">
            <span class="res-title"><i class="fas fa-fire-flame-curved"></i> Pontos de Mana (PM)</span>
            <div class="res-inputs-group">
              <input
                type="text"
                name="system.resources.mana.value"
                value="{{system.resources.mana.value}}"
                data-dtype="Number"
                class="res-input-current"
                title="Mana Atual"
              />
              <span class="res-slash">/</span>
              <input
                type="text"
                name="system.resources.mana.max"
                value="{{system.resources.mana.max}}"
                data-dtype="Number"
                class="res-input-max"
                title="Mana Máxima"
              />
            </div>
          </div>
          <div class="resource-track">
            <div class="resource-fill fill-mana" style="width: {{#if manaPct}}{{manaPct}}{{else}}100{{/if}}%;"></div>
          </div>
        </div>

      </section>

      {{!-- SUB-ATRIBUTOS TÁTICOS (INICIATIVA, DESLOCAMENTO, CORRIDA, CARGA) --}}
      <section class="tactical-subattributes-grid">
        <div class="tactical-card rollable" data-roll-type="attribute" data-attribute="agilidade" title="Iniciativa: 2d6 + Bônus">
          <span class="tactical-label"><i class="fas fa-bolt"></i> Iniciativa</span>
          <span class="tactical-val">2d6 + {{system.subattributes.iniciativa.value}}</span>
        </div>
        <div class="tactical-card" title="Deslocamento Normal">
          <span class="tactical-label"><i class="fas fa-person-walking"></i> Deslocamento</span>
          <span class="tactical-val">{{{system.subattributes.deslocamento.formulaVisual}}} = <strong>{{system.subattributes.deslocamento.value}}m</strong></span>
        </div>
        <div class="tactical-card" title="Corrida Máxima">
          <span class="tactical-label"><i class="fas fa-person-running"></i> Corrida</span>
          <span class="tactical-val"><strong>{{system.subattributes.corrida.value}}m</strong></span>
        </div>
        <div class="tactical-card" title="Capacidade de Carga">
          <span class="tactical-label"><i class="fas fa-weight-hanging"></i> Carga</span>
          <span class="tactical-val"><strong>{{system.subattributes.carga.value}} kg</strong></span>
        </div>
      </section>

      {{!-- DEFESAS CANÔNICAS (BLOQUEIO, ESQUIVA, DETERMINAÇÃO) --}}
      <section class="defenses-cards-grid">
        <div class="defense-card defense-card-bloqueio">
          <div class="defense-header">
            <i class="fas fa-shield"></i>
            <span>{{localize "MB.Bloqueio"}}</span>
          </div>
          <div class="defense-body">
            <span class="defense-formula">{{{system.defesas.bloqueio.formulaVisual}}}</span>
            <span class="defense-total">{{system.defesas.bloqueio.value}}</span>
          </div>
        </div>

        <div class="defense-card defense-card-esquiva">
          <div class="defense-header">
            <i class="fas fa-angles-right"></i>
            <span>{{localize "MB.Esquiva"}}</span>
          </div>
          <div class="defense-body">
            <span class="defense-formula">{{{system.defesas.esquiva.formulaVisual}}}</span>
            <span class="defense-total">{{system.defesas.esquiva.value}}</span>
          </div>
        </div>

        <div class="defense-card defense-card-determinacao">
          <div class="defense-header">
            <i class="fas fa-brain"></i>
            <span>{{localize "MB.Determinacao"}}</span>
          </div>
          <div class="defense-body">
            <span class="defense-formula">{{{system.defesas.determinacao.formulaVisual}}}</span>
            <span class="defense-total">{{system.defesas.determinacao.value}}</span>
          </div>
        </div>
      </section>

      {{!-- ARMAS & ATAQUES TÁTICOS --}}
      <section class="attacks-section">
        <div class="section-title-bar">
          <span><i class="fas fa-swords"></i> Armas & Ataques</span>
        </div>
        <ol class="items-list attacks-list">
          <li class="item flexrow items-header">
            <div class="item-name">Arma</div>
            <div class="item-formula">Fórmula de Dano</div>
            <div class="item-controls">Ações</div>
          </li>
          {{#each gear as |item id|}}
            {{#if (eq item.type "arma")}}
              <li class="item flexrow attack-item" data-item-id="{{item._id}}">
                <div class="item-name">
                  <div class="item-image">
                    <a class="rollable" data-roll-type="item" title="Rolar Ataque com {{item.name}}">
                      <img src="{{item.img}}" title="{{item.name}}" width="28" height="28" />
                    </a>
                  </div>
                  <h4>{{item.name}}</h4>
                </div>
                <div class="item-formula">
                  <span class="badge-dano">{{item.system.dano}}</span>
                </div>
                <div class="item-controls">
                  <a class="item-control item-edit" title="Editar Arma"><i class="fas fa-edit"></i></a>
                  {{#if ../flags.mighty-blade.isEditing}}
                  <a class="item-control item-delete" title="Excluir Arma"><i class="fas fa-trash"></i></a>
                  {{/if}}
                </div>
              </li>
            {{/if}}
          {{/each}}
        </ol>
      </section>

      {{!-- CARTEIRA & DETALHES COMPLEMENTARES --}}
      <section class="notes-economy-section">
        <div class="wallet-badge-row">
          <span class="wallet-label"><i class="fas fa-coins" style="color:#fbbf24;"></i> Dinheiro:</span>
          <input
            type="number"
            name="system.details.dinheiro"
            value="{{system.details.dinheiro}}"
            class="wallet-input"
          />
          <span class="wallet-currency">Moedas de Prata</span>
        </div>

        <div class="notes-grid-2col">
          <div class="note-card">
            <label class="note-label"><i class="fas fa-comments"></i> Idiomas</label>
            <textarea name="system.details.idiomas" rows="2" placeholder="Idiomas conhecidos...">{{system.details.idiomas}}</textarea>
          </div>
          <div class="note-card">
            <label class="note-label"><i class="fas fa-compass"></i> Motivação</label>
            <textarea name="system.details.motivacao" rows="2" placeholder="Objetivos e motivações...">{{system.details.motivacao}}</textarea>
          </div>
          <div class="note-card">
            <label class="note-label"><i class="fas fa-heart-pulse"></i> Condição</label>
            <textarea name="system.details.condicao" rows="2" placeholder="Condições físicas e ferimentos...">{{system.details.condicao}}</textarea>
          </div>
          <div class="note-card">
            <label class="note-label"><i class="fas fa-scroll"></i> Evolução / Anotações</label>
            <textarea name="system.details.evolucao" rows="2" placeholder="Histórico de evolução e notas...">{{system.details.evolucao}}</textarea>
          </div>
        </div>
      </section>

    </div>

    {{!-- ───────────────────────────────────────────────────────────
          ABA 2: EQUIPAMENTOS / INVENTÁRIO
    ─────────────────────────────────────────────────────────────── --}}
    <div class="tab items" data-group="primary" data-tab="items">
      {{> "systems/mighty-blade/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- ───────────────────────────────────────────────────────────
          ABA 3: HABILIDADES
    ─────────────────────────────────────────────────────────────── --}}
    <div class="tab features" data-group="primary" data-tab="features">
      {{> "systems/mighty-blade/templates/actor/parts/actor-features.hbs"}}
    </div>

    {{!-- ───────────────────────────────────────────────────────────
          ABA 4: MAGIAS
    ─────────────────────────────────────────────────────────────── --}}
    <div class="tab spells" data-group="primary" data-tab="spells">
      {{> "systems/mighty-blade/templates/actor/parts/actor-spells.hbs"}}
    </div>

    {{!-- ───────────────────────────────────────────────────────────
          ABA 5: EFEITOS
    ─────────────────────────────────────────────────────────────── --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
      {{> "systems/mighty-blade/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>
