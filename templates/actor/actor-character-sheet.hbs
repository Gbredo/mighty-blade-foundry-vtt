<form class="{{cssClass}} mighty-blade dnd5e-theme mb-sheet-dark" autocomplete="off">

  {{!-- ═══════════════════════════════════════════════════════════
        CABEÇALHO SUPERIOR (NOME, DESCANSO, NÍVEL & XP)
  ════════════════════════════════════════════════════════════════ --}}
  <header class="sheet-header-dnd">
    {{!-- Identidade e Nome --}}
    <div class="header-name-box">
      <h1 class="charname">
        <input
          name="name"
          type="text"
          value="{{actor.name}}"
          placeholder="Nome do Herói"
        />
      </h1>
      <span class="char-subtitle">
        {{#if raca}}{{raca.name}}{{else}}Herói{{/if}}
        {{#if classe}}• {{classe.name}}{{/if}}
        {{#if caminho}}({{caminho.name}}){{/if}}
      </span>
    </div>

    {{!-- Ações Rápidas de Descanso (Estilo D&D 5e: Short & Long Rest) --}}
    <div class="header-rest-box">
      <a class="rest-btn rest-short-btn" data-tooltip="Recuperação Rápida (Descanso Curto: +50% PV e PM)">
        <i class="fas fa-utensils"></i>
      </a>
      <a class="rest-btn rest-long-btn" data-tooltip="Descanso Completo (Descanso Longo: 100% PV e PM)">
        <i class="fas fa-campground"></i>
      </a>
    </div>

    {{!-- Badge Circular de Nível & Barra de XP --}}
    <div class="header-level-box">
      <div class="level-circle-badge level-up-trigger" data-tooltip="Clique para Evoluir / Subir de Nível">
        <span class="level-num">{{system.details.nivel}}</span>
        <span class="level-lbl">NÍVEL</span>
      </div>
      <div class="xp-progress-container">
        <div class="xp-labels-row">
          <span class="xp-current">{{system.details.experiencia}} / {{xpMeta}} XP</span>
        </div>
        <div class="xp-track-bar">
          <div class="xp-fill-bar" style="width: {{xpPct}}%;"></div>
        </div>
      </div>
    </div>

    {{!-- Trava de Edição / Configurações --}}
    <div class="header-config-box">
      <a class="sheet-config {{#if flags.mighty-blade.isEditing}}editing{{/if}}" data-tooltip="{{#if flags.mighty-blade.isEditing}}Salvar e Travar Ficha{{else}}Habilitar Edição Manual{{/if}}">
        <i class="fas {{#if flags.mighty-blade.isEditing}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
      </a>
    </div>
  </header>

  {{!-- ═══════════════════════════════════════════════════════════
        LAYOUT DE 3 ZONAS: SIDEBAR | CORPO DAS ABAS | ABAS VERTICAIS
  ════════════════════════════════════════════════════════════════ --}}
  <div class="sheet-layout-dnd">

    {{!-- ───────────────────────────────────────────────────────────
          1. SIDEBAR TÁTICA ESQUERDA
    ─────────────────────────────────────────────────────────────── --}}
    <aside class="sheet-sidebar-dnd">
      
      {{!-- Avatar do Personagem --}}
      <div class="avatar-card-dnd">
        <img
          class="profile-img"
          src="{{actor.img}}"
          data-edit="img"
          title="{{actor.name}}"
        />
      </div>

      {{!-- Tríade de Defesas do Mighty Blade (Escudos) --}}
      <div class="sidebar-defenses-grid">
        {{!-- Bloqueio (Defesa Primária) --}}
        <div class="defense-shield-box defense-bloqueio" data-tooltip="<strong>Bloqueio:</strong> {{{system.defesas.bloqueio.formulaVisual}}}">
          <i class="fas fa-shield shield-icon"></i>
          <span class="defense-val">{{system.defesas.bloqueio.value}}</span>
          <span class="defense-name">BLOQUEIO</span>
        </div>

        {{!-- Esquiva --}}
        <div class="defense-mini-box defense-esquiva" data-tooltip="<strong>Esquiva:</strong> {{{system.defesas.esquiva.formulaVisual}}}">
          <i class="fas fa-angles-right mini-icon"></i>
          <span class="defense-val">{{system.defesas.esquiva.value}}</span>
          <span class="defense-name">ESQUIVA</span>
        </div>

        {{!-- Determinação --}}
        <div class="defense-mini-box defense-determinacao" data-tooltip="<strong>Determinação:</strong> {{{system.defesas.determinacao.formulaVisual}}}">
          <i class="fas fa-brain mini-icon"></i>
          <span class="defense-val">{{system.defesas.determinacao.value}}</span>
          <span class="defense-name">DETERMINAÇÃO</span>
        </div>
      </div>

      {{!-- Métricas Táticas (Iniciativa, Deslocamento, Corrida) --}}
      <div class="sidebar-tactical-row">
        <div class="tactical-item rollable" data-roll-type="attribute" data-attribute="agilidade" data-tooltip="Rolar Iniciativa (2d6 + Bônus)">
          <i class="fas fa-bolt"></i>
          <span class="tactical-num">+{{system.subattributes.iniciativa.value}}</span>
          <span class="tactical-lbl">INICIATIVA</span>
        </div>
        <div class="tactical-item" data-tooltip="Deslocamento Normal: {{{system.subattributes.deslocamento.formulaVisual}}}">
          <i class="fas fa-person-walking"></i>
          <span class="tactical-num">{{system.subattributes.deslocamento.value}}m</span>
          <span class="tactical-lbl">DESLOC.</span>
        </div>
        <div class="tactical-item" data-tooltip="Corrida Máxima por Rodada">
          <i class="fas fa-person-running"></i>
          <span class="tactical-num">{{system.subattributes.corrida.value}}m</span>
          <span class="tactical-lbl">CORRIDA</span>
        </div>
      </div>

      {{!-- Recursos Vitais (Vida & Mana com Barras de Preenchimento) --}}
      <div class="sidebar-resources-box">
        {{!-- PONTOS DE VIDA (PV) --}}
        <div class="resource-block resource-vida">
          <div class="res-label-row">
            <span class="res-tag"><i class="fas fa-heart"></i> VIDA</span>
            <div class="res-inputs">
              <input type="number" name="system.resources.vida.value" value="{{system.resources.vida.value}}" class="res-curr" min="0" max="{{system.resources.vida.max}}" />
              <span class="res-sep">/</span>
              <input type="number" name="system.resources.vida.max" value="{{system.resources.vida.max}}" class="res-max" min="0" />
            </div>
          </div>
          <div class="res-bar-track">
            <div class="res-bar-fill fill-vida" style="width: {{vidaPct}}%;"></div>
          </div>
        </div>

        {{!-- PONTOS DE MANA (PM) --}}
        <div class="resource-block resource-mana">
          <div class="res-label-row">
            <span class="res-tag"><i class="fas fa-fire-flame-curved"></i> MANA</span>
            <div class="res-inputs">
              <input type="number" name="system.resources.mana.value" value="{{system.resources.mana.value}}" class="res-curr" min="0" max="{{system.resources.mana.max}}" />
              <span class="res-sep">/</span>
              <input type="number" name="system.resources.mana.max" value="{{system.resources.mana.max}}" class="res-max" min="0" />
            </div>
          </div>
          <div class="res-bar-track">
            <div class="res-bar-fill fill-mana" style="width: {{manaPct}}%;"></div>
          </div>
        </div>
      </div>

      {{!-- Seção de Favoritos (Drop Favorite estilo D&D 5e) --}}
      <div class="sidebar-favorites-box">
        <div class="favorites-header-title">
          <i class="fas fa-star star-fav-icon"></i>
          <span>FAVORITOS</span>
        </div>
        <div class="favorites-list-container">
          {{#if favorites.length}}
            <ul class="favorites-items-list">
              {{#each favorites as |fav|}}
                <li class="favorite-item-pill item" data-item-id="{{fav._id}}">
                  <img src="{{fav.img}}" class="fav-thumb" width="20" height="20" />
                  <span class="fav-name rollable" data-roll-type="item" data-tooltip="Rolar {{fav.name}}">{{fav.name}}</span>
                  <a class="item-favorite-toggle" data-tooltip="Remover dos Favoritos"><i class="fas fa-star active-star"></i></a>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <div class="favorites-empty-slot">
              <span>Arraste ou clique na estrela (⭐) de um item para fixar aqui</span>
            </div>
          {{/if}}
        </div>
      </div>

    </aside>

    {{!-- ───────────────────────────────────────────────────────────
          2. CONTEÚDO CENTRAL (CORPO DAS ABAS)
    ─────────────────────────────────────────────────────────────── --}}
    <main class="sheet-body-dnd sheet-body">

      {{!-- ═══════════════════════════════════════════════════════════
            ABA 1: ATRIBUTOS & NÚCLEO HEROICO
      ════════════════════════════════════════════════════════════════ --}}
      <div class="tab attributes active" data-group="primary" data-tab="attributes">
        
        {{!-- OS 4 ATRIBUTOS EM BADGES GEOMÉTRICOS ESTILO D&D 5E --}}
        <section class="dnd-attributes-strip">
          
          {{!-- FORÇA --}}
          <div class="dnd-attr-card rollable" data-roll-type="attribute" data-attribute="forca" data-tooltip="Rolar Teste de Força (2d6 + FOR)">
            <span class="attr-score">{{system.attributes.forca.value}}</span>
            <div class="attr-meta">
              <span class="attr-code">FOR</span>
              <span class="attr-label">{{localize "MB.Forca"}}</span>
            </div>
            {{#if flags.mighty-blade.isEditing}}
              <input type="number" name="system.attributes.forca.base" value="{{system.attributes.forca.base}}" class="attr-edit-input" title="Base" />
            {{/if}}
            <i class="fas fa-dice-d6 attr-roll-dice"></i>
          </div>

          {{!-- AGILIDADE --}}
          <div class="dnd-attr-card rollable" data-roll-type="attribute" data-attribute="agilidade" data-tooltip="Rolar Teste de Agilidade (2d6 + AGI)">
            <span class="attr-score">{{system.attributes.agilidade.value}}</span>
            <div class="attr-meta">
              <span class="attr-code">AGI</span>
              <span class="attr-label">{{localize "MB.Agilidade"}}</span>
            </div>
            {{#if flags.mighty-blade.isEditing}}
              <input type="number" name="system.attributes.agilidade.base" value="{{system.attributes.agilidade.base}}" class="attr-edit-input" title="Base" />
            {{/if}}
            <i class="fas fa-dice-d6 attr-roll-dice"></i>
          </div>

          {{!-- INTELIGÊNCIA --}}
          <div class="dnd-attr-card rollable" data-roll-type="attribute" data-attribute="inteligencia" data-tooltip="Rolar Teste de Inteligência (2d6 + INT)">
            <span class="attr-score">{{system.attributes.inteligencia.value}}</span>
            <div class="attr-meta">
              <span class="attr-code">INT</span>
              <span class="attr-label">{{localize "MB.Inteligencia"}}</span>
            </div>
            {{#if flags.mighty-blade.isEditing}}
              <input type="number" name="system.attributes.inteligencia.base" value="{{system.attributes.inteligencia.base}}" class="attr-edit-input" title="Base" />
            {{/if}}
            <i class="fas fa-dice-d6 attr-roll-dice"></i>
          </div>

          {{!-- VONTADE --}}
          <div class="dnd-attr-card rollable" data-roll-type="attribute" data-attribute="vontade" data-tooltip="Rolar Teste de Vontade (2d6 + VON)">
            <span class="attr-score">{{system.attributes.vontade.value}}</span>
            <div class="attr-meta">
              <span class="attr-code">VON</span>
              <span class="attr-label">{{localize "MB.Vontade"}}</span>
            </div>
            {{#if flags.mighty-blade.isEditing}}
              <input type="number" name="system.attributes.vontade.base" value="{{system.attributes.vontade.base}}" class="attr-edit-input" title="Base" />
            {{/if}}
            <i class="fas fa-dice-d6 attr-roll-dice"></i>
          </div>

        </section>

        {{!-- PAINEL DE 2 COLUNAS: AÇÕES/COMBATE (ESQ) & SLOTS DE IDENTIDADE (DIR) --}}
        <div class="attributes-split-grid">
          
          {{!-- COLUNA ESQUERDA: ARMAS EQUIPADAS & COMBATE RÁPIDO --}}
          <div class="split-col-left">
            
            <div class="panel-box-dnd">
              <div class="panel-box-header">
                <span><i class="fas fa-swords"></i> ARMAS EQUIPADAS</span>
                <a class="open-compendium-browser comp-link" data-type="arma" title="Explorar Compêndio de Armas">
                  <i class="fas fa-book-open"></i> Compêndio
                </a>
              </div>
              <div class="panel-box-content">
                {{#if equippedWeapons.length}}
                  <ul class="quick-weapons-list">
                    {{#each equippedWeapons as |w|}}
                      <li class="quick-weapon-row item" data-item-id="{{w._id}}">
                        <img src="{{w.img}}" class="quick-weapon-icon rollable" data-roll-type="item" data-tooltip="Rolar Ataque" />
                        <div class="quick-weapon-info">
                          <span class="quick-weapon-name rollable" data-roll-type="item">{{w.name}}</span>
                          <span class="quick-weapon-sub">{{w.system.alcance}} • FN {{w.system.fn}}</span>
                        </div>
                        <span class="quick-weapon-dmg badge-dano">{{w.system.dano}}</span>
                        <div class="quick-weapon-actions">
                          <a class="item-favorite-toggle" data-tooltip="Favoritar"><i class="fas fa-star {{#if w.flags.mighty-blade.isFavorite}}active-star{{/if}}"></i></a>
                          <a class="item-edit" data-tooltip="Editar"><i class="fas fa-edit"></i></a>
                        </div>
                      </li>
                    {{/each}}
                  </ul>
                {{else}}
                  <div class="empty-state-card">
                    <p>Nenhuma arma equipada no momento.</p>
                    <a class="open-compendium-browser action-link" data-type="arma"><i class="fas fa-plus"></i> Equipar uma Arma</a>
                  </div>
                {{/if}}
              </div>
            </div>

            {{!-- TRAÇOS, IDIOMAS & CONDIÇÕES --}}
            <div class="panel-box-dnd traits-panel">
              <div class="panel-box-header">
                <span><i class="fas fa-scroll"></i> TRAÇOS & CONDIÇÕES</span>
              </div>
              <div class="panel-box-content traits-grid">
                <div class="trait-field">
                  <label><i class="fas fa-comments"></i> Idiomas Conhecidos:</label>
                  <input type="text" name="system.details.idiomas" value="{{system.details.idiomas}}" placeholder="Ex: Comum, Élfico, Anão..." />
                </div>
                <div class="trait-field">
                  <label><i class="fas fa-heart-pulse"></i> Condição Atual:</label>
                  <input type="text" name="system.details.condicao" value="{{system.details.condicao}}" placeholder="Normal / Condições ativas..." />
                </div>
                <div class="trait-field">
                  <label><i class="fas fa-compass"></i> Motivação:</label>
                  <input type="text" name="system.details.motivacao" value="{{system.details.motivacao}}" placeholder="Motivação ou objetivo do herói..." />
                </div>
              </div>
            </div>

          </div>

          {{!-- COLUNA DIREITA: SLOTS DE IDENTIDADE HEROICA (ESTILO D&D 5E) --}}
          <div class="split-col-right">
            <div class="identity-slots-panel">
              
              {{!-- 1. SLOT DE RAÇA --}}
              <div class="identity-slot-card slot-raca">
                <div class="slot-header">
                  <span class="slot-title"><i class="fas fa-user"></i> RAÇA</span>
                </div>
                {{#if raca}}
                  <div class="slot-filled-content item" data-item-id="{{raca._id}}">
                    <img src="{{raca.img}}" class="slot-thumb" />
                    <div class="slot-info">
                      <strong class="slot-name">{{raca.name}}</strong>
                    </div>
                    <div class="slot-actions">
                      {{#if raca.advancementTargetId}}
                        <a class="item-control reconfigure-advancement-btn" data-item-id="{{raca.advancementTargetId}}" title="Reconfigurar Avanço Racial ({{raca.name}})"><i class="fas fa-sliders"></i></a>
                      {{/if}}
                      <a class="item-control item-replace" title="Trocar Raça" data-type="raca"><i class="fas fa-exchange-alt"></i></a>
                      <a class="item-control item-edit" title="Editar Raça"><i class="fas fa-edit"></i></a>
                      {{#if flags.mighty-blade.isEditing}}
                        <a class="item-control item-delete" title="Remover"><i class="fas fa-trash"></i></a>
                      {{/if}}
                    </div>
                  </div>
                {{else}}
                  <a class="slot-empty-placeholder open-compendium-browser" data-type="raca">
                    <i class="fas fa-plus-circle"></i>
                    <span>ESCOLHER RAÇA</span>
                  </a>
                {{/if}}
              </div>

              {{!-- 2. SLOT DE CLASSE (COM APRENDIZ) --}}
              <div class="identity-slot-card slot-classe">
                <div class="slot-header">
                  <span class="slot-title"><i class="fas fa-shield-halved"></i> CLASSE</span>
                </div>
                {{#if classe}}
                  <div class="slot-filled-content item" data-item-id="{{classe._id}}">
                    <img src="{{classe.img}}" class="slot-thumb" />
                    <div class="slot-info">
                      <strong class="slot-name">{{classe.name}}</strong>
                      {{#if system.details.aprendiz}}
                        <span class="slot-sub-aprendiz">
                          ↳ Aprendiz: <strong>{{#if formattedAprendiz}}{{formattedAprendiz}}{{else}}{{system.details.aprendiz}}{{/if}}</strong>
                          {{#if flags.mighty-blade.isEditing}}
                            <a class="clear-detail-btn" data-detail="aprendiz" data-tooltip="Remover Aprendiz" style="color:#ef4444;margin-left:4px;cursor:pointer;"><i class="fas fa-times-circle"></i></a>
                          {{/if}}
                        </span>
                      {{else if isLevel2Plus}}
                        <a class="choose-aprendiz-btn slot-link-sub">+ Aprendiz de Classe</a>
                      {{/if}}
                    </div>
                    <div class="slot-actions">
                      <a class="item-control item-replace" title="Trocar Classe" data-type="classe"><i class="fas fa-exchange-alt"></i></a>
                      <a class="item-control item-edit" title="Editar Classe"><i class="fas fa-edit"></i></a>
                      {{#if flags.mighty-blade.isEditing}}
                        <a class="item-control item-delete" title="Remover"><i class="fas fa-trash"></i></a>
                      {{/if}}
                    </div>
                  </div>
                {{else}}
                  <a class="slot-empty-placeholder open-compendium-browser" data-type="classe">
                    <i class="fas fa-plus-circle"></i>
                    <span>ESCOLHER CLASSE</span>
                  </a>
                {{/if}}
              </div>

              {{!-- 3. SLOT DE CAMINHO --}}
              <div class="identity-slot-card slot-caminho">
                <div class="slot-header">
                  <span class="slot-title"><i class="fas fa-route"></i> CAMINHO</span>
                </div>
                {{#if caminho}}
                  <div class="slot-filled-content item" data-item-id="{{caminho._id}}">
                    <img src="{{caminho.img}}" class="slot-thumb" />
                    <div class="slot-info">
                      <strong class="slot-name">{{caminho.name}}</strong>
                    </div>
                    <div class="slot-actions">
                      <a class="item-control item-replace" title="Trocar Caminho" data-type="caminho"><i class="fas fa-exchange-alt"></i></a>
                      <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
                      {{#if flags.mighty-blade.isEditing}}
                        <a class="item-control item-delete" title="Remover"><i class="fas fa-trash"></i></a>
                      {{/if}}
                    </div>
                  </div>
                {{else if system.details.caminho}}
                  <div class="slot-filled-content">
                    {{#if caminhoImg}}<img src="{{caminhoImg}}" class="slot-thumb" />{{/if}}
                    <div class="slot-info">
                      <strong class="slot-name">{{#if formattedCaminho}}{{formattedCaminho}}{{else}}{{system.details.caminho}}{{/if}}</strong>
                    </div>
                    <div class="slot-actions">
                      <a class="item-control item-replace" title="Trocar Caminho" data-type="caminho"><i class="fas fa-exchange-alt"></i></a>
                      {{#if flags.mighty-blade.isEditing}}
                        <a class="item-control clear-detail-btn" data-detail="caminho" title="Remover"><i class="fas fa-trash"></i></a>
                      {{/if}}
                    </div>
                  </div>
                {{else}}
                  <a class="slot-empty-placeholder open-compendium-browser" data-type="caminho">
                    <i class="fas fa-plus-circle"></i>
                    <span>ESCOLHER CAMINHO</span>
                  </a>
                {{/if}}
              </div>

              {{!-- 4. SLOT DE ORGANIZAÇÃO --}}
              <div class="identity-slot-card slot-organizacao">
                <div class="slot-header">
                  <span class="slot-title"><i class="fas fa-landmark"></i> ORGANIZAÇÃO</span>
                </div>
                {{#if organizacao}}
                  <div class="slot-filled-content item" data-item-id="{{organizacao._id}}">
                    <img src="{{organizacao.img}}" class="slot-thumb" />
                    <div class="slot-info">
                      <strong class="slot-name" style="color:#c084fc;">{{organizacao.name}}</strong>
                    </div>
                    <div class="slot-actions">
                      <a class="item-control item-replace" title="Trocar Organização" data-type="organizacao"><i class="fas fa-exchange-alt"></i></a>
                      <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
                      {{#if flags.mighty-blade.isEditing}}
                        <a class="item-control item-delete" title="Remover"><i class="fas fa-trash"></i></a>
                      {{/if}}
                    </div>
                  </div>
                {{else if system.details.organizacao}}
                  <div class="slot-filled-content">
                    {{#if organizacaoImg}}<img src="{{organizacaoImg}}" class="slot-thumb" />{{/if}}
                    <div class="slot-info">
                      <strong class="slot-name" style="color:#c084fc;">{{#if formattedOrganizacao}}{{formattedOrganizacao}}{{else}}{{system.details.organizacao}}{{/if}}</strong>
                    </div>
                    <div class="slot-actions">
                      <a class="item-control item-replace" title="Trocar Organização" data-type="organizacao"><i class="fas fa-exchange-alt"></i></a>
                      {{#if flags.mighty-blade.isEditing}}
                        <a class="item-control clear-detail-btn" data-detail="organizacao" title="Remover"><i class="fas fa-trash"></i></a>
                      {{/if}}
                    </div>
                  </div>
                {{else}}
                  <a class="slot-empty-placeholder open-compendium-browser" data-type="organizacao">
                    <i class="fas fa-plus-circle"></i>
                    <span>ESCOLHER ORGANIZAÇÃO</span>
                  </a>
                {{/if}}
              </div>

              {{!-- 5. SLOT DE ANTECEDENTE --}}
              <div class="identity-slot-card slot-antecedente">
                <div class="slot-header">
                  <span class="slot-title"><i class="fas fa-feather-pointed"></i> ANTECEDENTE</span>
                </div>
                {{#if antecedentes.length}}
                  {{#each antecedentes as |ant|}}
                    <div class="slot-filled-content item" data-item-id="{{ant._id}}">
                      <img src="{{ant.img}}" class="slot-thumb" />
                      <div class="slot-info">
                        <strong class="slot-name">{{ant.name}}</strong>
                      </div>
                      <div class="slot-actions">
                        <a class="item-control choose-antecedente-btn" title="Trocar Antecedente"><i class="fas fa-exchange-alt"></i></a>
                        <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
                        {{#if ../flags.mighty-blade.isEditing}}
                          <a class="item-control item-delete" title="Remover"><i class="fas fa-trash"></i></a>
                        {{/if}}
                      </div>
                    </div>
                  {{/each}}
                {{else if system.details.antecedente}}
                  <div class="slot-filled-content">
                    <div class="slot-info">
                      <strong class="slot-name">{{system.details.antecedente}}</strong>
                      <span class="slot-sub">Antepassado Canônico</span>
                    </div>
                    <div class="slot-actions">
                      <a class="choose-antecedente-btn" title="Trocar Antecedente"><i class="fas fa-exchange-alt"></i></a>
                      {{#if flags.mighty-blade.isEditing}}
                        <a class="clear-detail-btn" data-detail="antecedente" title="Remover"><i class="fas fa-trash"></i></a>
                      {{/if}}
                    </div>
                  </div>
                {{else}}
                  <a class="slot-empty-placeholder choose-antecedente-btn">
                    <i class="fas fa-plus-circle"></i>
                    <span>ESCOLHER ANTECEDENTE</span>
                  </a>
                {{/if}}
              </div>

            </div>
          </div>

        </div>

      </div>

      {{!-- ═══════════════════════════════════════════════════════════
            ABA 2: INVENTÁRIO & ARSENAL
      ════════════════════════════════════════════════════════════════ --}}
      <div class="tab items" data-group="primary" data-tab="items">
        {{> "systems/mighty-blade/templates/actor/parts/actor-items.hbs"}}
      </div>

      {{!-- ═══════════════════════════════════════════════════════════
            ABA 3: HABILIDADES & CARACTERÍSTICAS
      ════════════════════════════════════════════════════════════════ --}}
      <div class="tab features" data-group="primary" data-tab="features">
        {{> "systems/mighty-blade/templates/actor/parts/actor-features.hbs"}}
      </div>

      {{!-- ═══════════════════════════════════════════════════════════
            ABA 4: MAGIAS & GRIMÓRIO
      ════════════════════════════════════════════════════════════════ --}}
      <div class="tab spells" data-group="primary" data-tab="spells">
        {{> "systems/mighty-blade/templates/actor/parts/actor-spells.hbs"}}
      </div>

      {{!-- ═══════════════════════════════════════════════════════════
            ABA 5: EFEITOS & CONDIÇÕES
      ════════════════════════════════════════════════════════════════ --}}
      <div class="tab effects" data-group="primary" data-tab="effects">
        {{> "systems/mighty-blade/templates/actor/parts/actor-effects.hbs"}}
      </div>

      {{!-- ═══════════════════════════════════════════════════════════
            ABA 6: BIOGRAFIA & ANOTAÇÕES DE CAMPANHA
      ════════════════════════════════════════════════════════════════ --}}
      <div class="tab biography" data-group="primary" data-tab="biography">
        <div class="biography-panel-dnd">
          <div class="panel-box-header">
            <span><i class="fas fa-book"></i> HISTÓRIA & BIOGRAFIA DO PERSONAGEM</span>
          </div>
          <div class="biography-editor-container">
            {{editor enrichedBiography target="system.biography" rollData=rollData button=true owner=owner editable=editable}}
          </div>
          <div class="notes-footer-row">
            <div class="note-box">
              <label><i class="fas fa-scroll"></i> Histórico de Evolução & Anotações:</label>
              <textarea name="system.details.evolucao" rows="3" placeholder="Anotações de evolução...">{{system.details.evolucao}}</textarea>
            </div>
          </div>
        </div>
      </div>

    </main>

    {{!-- ───────────────────────────────────────────────────────────
          3. BARRA DE ABAS VERTICAL À DIREITA (ESTILO D&D 5E)
    ─────────────────────────────────────────────────────────────── --}}
    <nav class="sheet-tabs-vertical sheet-tabs tabs" data-group="primary">
      <a class="item active" data-tab="attributes" data-tooltip="Atributos & Núcleo">
        <i class="fas fa-gear"></i>
      </a>
      <a class="item" data-tab="items" data-tooltip="Inventário & Arsenal">
        <i class="fas fa-sack-dollar"></i>
      </a>
      <a class="item" data-tab="features" data-tooltip="Habilidades & Características">
        <i class="fas fa-book-sparkles"></i>
      </a>
      <a class="item" data-tab="spells" data-tooltip="Magias & Grimório">
        <i class="fas fa-bolt"></i>
      </a>
      <a class="item" data-tab="effects" data-tooltip="Efeitos & Condições">
        <i class="fas fa-feather"></i>
      </a>
      <a class="item" data-tab="biography" data-tooltip="Biografia & Lore">
        <i class="fas fa-scroll"></i>
      </a>
    </nav>

  </div>

</form>
